<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="80dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:layout_marginBottom="8dp" android:background="@color/app_surface">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
    <TextView android:id="@+id/dictionary_download_locale"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/app_text"/>
    <TextView android:id="@+id/dictionary_download_size"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textSize="12sp" android:textColor="@color/app_secondary"/>
    <TextView android:id="@+id/dictionary_download_status"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textSize="12sp" android:textColor="@color/app_secondary" android:accessibilityLiveRegion="polite"
        android:visibility="gone"/>
  </LinearLayout>
  <ProgressBar android:id="@+id/dictionary_download_progress"
      style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp"
      android:visibility="gone" android:importantForAccessibility="no"/>
  <Button android:id="@+id/dictionary_download_button"
      android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="88dp"
      android:minHeight="48dp" android:paddingStart="10dp" android:paddingEnd="10dp"
      android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/app_accent_text"/>
</LinearLayout>
