<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/app_canvas" android:fillViewport="true" android:fitsSystemWindows="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dictionary_intro_title" android:textSize="22sp"
        android:fontFamily="sans-serif-medium" android:textColor="@color/app_text"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/dictionary_intro_body" android:textSize="15sp"
        android:lineSpacingExtra="3dp" android:textColor="@color/app_secondary"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:padding="14dp" android:background="@color/app_accent_soft"
        android:text="@string/dictionary_chinese_included" android:textSize="14sp"
        android:lineSpacingExtra="3dp" android:textColor="@color/app_accent_text"/>
    <TextView android:id="@+id/dictionary_recommended_heading"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:layout_marginBottom="10dp" android:text="@string/dictionary_recommended"
        android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/app_text"/>
    <juloo.keyboard2.dict.DictionaryListView android:id="@+id/dictionary_recommended_list"
        device_locales="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:layout_marginBottom="10dp" android:text="@string/dictionary_other_languages"
        android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/app_text"/>
    <juloo.keyboard2.dict.DictionaryListView device_locales="false"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
</ScrollView>
