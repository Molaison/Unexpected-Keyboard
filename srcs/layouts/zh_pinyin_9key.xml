<?xml version="1.0" encoding="utf-8"?>
<!-- Standard three-column T9 grid. Taps are ambiguous pinyin events; the
     bottom row owns editing and mode controls so the letter targets remain
     large and predictable. -->
<keyboard name="Chinese (Pinyin, 9-key)" script="latin" locale_extra_keys="false" bottom_row="false">
  <row>
    <key width="3.33" c="，" w="loc esc" e="loc tab" nw="switch_pinyin_layout" ne="1" sw="。" se="？" s="0"/>
    <key width="3.33" c="pinyin_2" ne="2" sw="'"/>
    <key width="3.33" c="pinyin_3" ne="3"/>
  </row>
  <row>
    <key width="3.33" c="pinyin_4" ne="4"/>
    <key width="3.33" c="pinyin_5" ne="5"/>
    <key width="3.33" c="pinyin_6" ne="6"/>
  </row>
  <row>
    <key width="3.33" c="pinyin_7" ne="7"/>
    <key width="3.33" c="pinyin_8" ne="8"/>
    <key width="3.33" c="pinyin_9" ne="9"/>
  </row>
  <row height="0.95">
    <key width="1.5" role="action" c="switch_numeric" sw="switch_clipboard" ne="switch_emoji"/>
    <key width="1.5" role="action" c="switch_pinyin" nw="loc ctrl"/>
    <key width="3.4" role="space_bar" c="space" w="cursor_left" e="cursor_right"/>
    <key width="1.4" role="action" c="backspace" ne="delete"/>
    <key width="0.9" role="action" c="voice_typing"/>
    <key width="1.3" role="action" c="enter" ne="action"/>
  </row>
</keyboard>
